{
  "name": "key-expressions-generator",
  "version": "1.0.0",
  "description": "Figma plugin for generating key expressions",
  "private": true,
  "scripts": {
    "build": "vite build --config vite.config.plugin.ts && vite build --config vite.config.ui.ts",
    "watch": "concurrently \"vite build --config vite.config.plugin.ts --watch\" \"vite build --config vite.config.ui.ts --watch\"",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.98.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^4.1.0"
  }
}
